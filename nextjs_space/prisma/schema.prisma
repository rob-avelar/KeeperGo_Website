
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(ORGANIZER)
  roles         String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Notification preferences
  emailNotifications         Boolean  @default(true)
  notifyBookingAccepted      Boolean  @default(true)
  notifyBookingCancelled     Boolean  @default(true)
  notifyMatchReminder24h     Boolean  @default(true)
  notifyMatchReminder2h      Boolean  @default(true)
  notifyPaymentReceived      Boolean  @default(true)

  accounts           Account[]
  sessions           Session[]
  goalkeeperProfile  GoalkeeperProfile?
  organizerBookings  Booking[]          @relation("OrganizerBookings")
  goalkeeperBookings Booking[]          @relation("GoalkeeperBookings")
  ratingsGiven       Rating[]           @relation("RatingsGiven")
  ratingsReceived    Rating[]           @relation("RatingsReceived")
  payments           Payment[]
  notifications      Notification[]
  favoriteGoalkeepers FavoriteGoalkeeper[] @relation("OrganizerFavorites")
  favoritedBy         FavoriteGoalkeeper[] @relation("GoalkeeperFavorites")
  betaInvite          BetaInvite[]
  referralCode        String?             @unique
  referredByCode      String?
  referralsMade       Referral[]          @relation("ReferralsMade")
  referralsReceived   Referral[]          @relation("ReferralsReceived")
  passwordResets      PasswordReset[]

  @@map("users")
}

model GoalkeeperProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  age               Int?
  bio               String?
  experienceLevel   String?
  preferredFields   String[]    @default([])
  serviceRadius     Int         @default(10)
  hourlyRateMin     Int         @default(2500)
  hourlyRateMax     Int         @default(5000)
  profilePhotoPath  String?
  availability      Json?
  isActive          Boolean     @default(true)
  totalMatches      Int         @default(0)
  averageRating     Float       @default(0.0)
  totalEarnings     Int         @default(0)
  latitude          Float?
  longitude         Float?
  address           String?
  city              String?
  postalCode        String?

  warningCount      Int         @default(0)
  warnings          Int         @default(0)
  blockedUntil      DateTime?
  isBlocked         Boolean     @default(false)
  blockReason       String?

  stripeAccountId       String?   @unique
  stripeAccountStatus   String?
  stripeOnboardingLink  String?
  stripeLinkExpiresAt   DateTime?
  stripeDetailsSubmitted Boolean  @default(false)
  stripeChargesEnabled   Boolean  @default(false)
  stripePayoutsEnabled   Boolean  @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("goalkeeper_profiles")
}

model Booking {
  id                  String        @id @default(cuid())
  organizerId         String
  goalkeeperId        String?
  goalkeeperProfileId String?
  date                DateTime
  duration            Int
  location            String
  latitude            Float?
  longitude           Float?
  fieldType           String
  pricePerHour        Int
  totalAmount         Int
  status              BookingStatus @default(PENDING)
  specialRequests     String?
  isCompleted         Boolean       @default(false)

  cancelledAt         DateTime?
  cancelledBy         String?
  cancellationReason  String?
  cancellationFee     Int?
  refundAmount        Int?

  isPriority              Boolean      @default(false)
  priorityReason          String?

  confirmationDeadline    DateTime?
  goalkeeperConfirmedAt   DateTime?
  confirmedAt             DateTime?
  noShow                  Boolean      @default(false)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organizer         User                  @relation("OrganizerBookings", fields: [organizerId], references: [id])
  goalkeeper        User?                 @relation("GoalkeeperBookings", fields: [goalkeeperId], references: [id])
  goalkeeperProfile GoalkeeperProfile?    @relation(fields: [goalkeeperProfileId], references: [id])
  ratings           Rating[]
  payments          Payment[]
  notifications     Notification[]

  @@map("bookings")
}

model Rating {
  id             String   @id @default(cuid())
  bookingId      String
  raterId        String
  ratedUserId    String
  punctuality    Int
  attitude       Int
  technicalSkill Int
  overallRating  Float
  comment        String?
  createdAt      DateTime @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rater     User    @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedUser User    @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  @@unique([bookingId, raterId])
  @@map("ratings")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  bookingId         String?
  stripePaymentId   String?       @unique
  amount            Int
  platformFee       Int
  goalkeeperEarning Int
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  stripeClientSecret String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  bookingId String?
  title     String
  message   String
  type      NotificationType
  isRead    Boolean            @default(false)
  data      Json?
  createdAt DateTime           @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model FavoriteGoalkeeper {
  id           String   @id @default(cuid())
  organizerId  String
  goalkeeperId String
  createdAt    DateTime @default(now())

  organizer  User @relation("OrganizerFavorites", fields: [organizerId], references: [id], onDelete: Cascade)
  goalkeeper User @relation("GoalkeeperFavorites", fields: [goalkeeperId], references: [id], onDelete: Cascade)

  @@unique([organizerId, goalkeeperId])
  @@map("favorite_goalkeepers")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ORGANIZER
  GOALKEEPER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFIRMED
  COMPLETED
  CANCELLED
  AWAITING_CONFIRMATION
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  RATING_REQUEST
  CONFIRMATION_REMINDER
  NO_SHOW_REPORTED
  PAYMENT_RELEASED
  WARNING_ISSUED
  BLOCKED
  GENERAL
}

model BetaInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String?
  role        UserRole?
  usedBy      String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  notes       String?

  user        User?     @relation(fields: [usedBy], references: [id])
}

model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  referredId      String?
  referralCode    String    @unique
  status          ReferralStatus @default(PENDING)
  rewardAmount    Int       @default(500)
  referrerRewarded Boolean  @default(false)
  referredRewarded Boolean  @default(false)
  createdAt       DateTime  @default(now())
  usedAt          DateTime?

  referrer        User      @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User?     @relation("ReferralsReceived", fields: [referredId], references: [id], onDelete: SetNull)

  @@map("referrals")
}

enum ReferralStatus {
  PENDING
  SIGNED_UP
  COMPLETED
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String
  type      String
  isActive  Boolean  @default(true)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("venues")
}

model AppSettings {
  id              String   @id @default("settings")
  betaModeEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}
